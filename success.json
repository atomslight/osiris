{
  "name": "Compare Sheets for Unique Data",
  "nodes": [
    {
      "parameters": {},
      "id": "start",
      "name": "Start",
      "type": "n8n-nodes-base.start",
      "typeVersion": 1,
      "position": [200, 300]
    },
    {
      "parameters": {
        "operation": "read",
        "spreadsheetId": "YOUR_SHEET1_ID",
        "sheetName": "Sheet1",
        "returnAllFields": true,
        "options": {}
      },
      "id": "readSheet1",
      "name": "Read Sheet 1",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 2,
      "position": [400, 200],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "_fullName",
              "value": "={{$json.Name}}"
            },
            {
              "name": "_companyName",
              "value": "={{$json.Company}}"
            },
            {
              "name": "_comparisonKey",
              "value": "={{$json.Name.toLowerCase() + '_' + ($json.Company || '').toLowerCase()}}"
            },
            {
              "name": "_sourceSheet",
              "value": "Sheet 1"
            }
          ]
        },
        "options": {}
      },
      "id": "prepareSheet1Data",
      "name": "Prepare Sheet 1 Data",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [600, 200]
    },
    {
      "parameters": {
        "operation": "read",
        "spreadsheetId": "YOUR_SHEET2_ID",
        "sheetName": "Sheet2",
        "returnAllFields": true,
        "options": {}
      },
      "id": "readSheet2",
      "name": "Read Sheet 2",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 2,
      "position": [400, 400],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "_fullName",
              "value": "={{$json['First Name']}} {{$json['Last Name']}}"
            },
            {
              "name": "_companyName",
              "value": "={{$json.Company}}"
            },
            {
              "name": "_comparisonKey",
              "value": "={{($json['First Name'] + ' ' + $json['Last Name']).toLowerCase() + '_' + ($json.Company || '').toLowerCase()}}"
            },
            {
              "name": "_sourceSheet",
              "value": "Sheet 2"
            }
          ]
        },
        "options": {}
      },
      "id": "prepareSheet2Data",
      "name": "Prepare Sheet 2 Data",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [600, 400]
    },
    {
      "parameters": {
        "mode": "append"
      },
      "id": "mergeData",
      "name": "Merge Data",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 2,
      "position": [800, 300]
    },
    {
      "parameters": {
        "jsCode": "const allItems = $input.all();\n\nconst keyCounts = new Map();\n\n// First pass: Populate keyCounts\nfor (const item of allItems) {\n  const comparisonKey = item.json._comparisonKey;\n  keyCounts.set(comparisonKey, (keyCounts.get(comparisonKey) || 0) + 1);\n}\n\n// Items that are unique to either sheet (symmetric difference)\nconst uniqueOutputItems = [];\n\nfor (const item of allItems) {\n  const comparisonKey = item.json._comparisonKey;\n  if (keyCounts.get(comparisonKey) === 1) {\n    uniqueOutputItems.push(item);\n  }\n}\n\nreturn uniqueOutputItems;"
      },
      "id": "filterSymmetricDifference",
      "name": "Filter Symmetric Difference",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1000, 300]
    },
    {
      "parameters": {
        "jsCode": "const allItems = $input.all();\n\nreturn allItems.map(item => {\n  const json = { ...item.json };\n  delete json._fullName;\n  delete json._companyName;\n  delete json._comparisonKey;\n  return { json };\n});"
      },
      "id": "cleanOutput",
      "name": "Clean Output",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1200, 300]
    }
  ],
  "connections": {
    "Start": {
      "main": [
        [
          { "node": "Read Sheet 1", "type": "main", "index": 0 },
          { "node": "Read Sheet 2", "type": "main", "index": 0 }
        ]
      ]
    },
    "Read Sheet 1": {
      "main": [
        [
          { "node": "Prepare Sheet 1 Data", "type": "main", "index": 0 }
        ]
      ]
    },
    "Prepare Sheet 1 Data": {
      "main": [
        [
          { "node": "Merge Data", "type": "main", "index": 0 }
        ]
      ]
    },
    "Read Sheet 2": {
      "main": [
        [
          { "node": "Prepare Sheet 2 Data", "type": "main", "index": 0 }
        ]
      ]
    },
    "Prepare Sheet 2 Data": {
      "main": [
        [
          { "node": "Merge Data", "type": "main", "index": 1 }
        ]
      ]
    },
    "Merge Data": {
      "main": [
        [
          { "node": "Filter Symmetric Difference", "type": "main", "index": 0 }
        ]
      ]
    },
    "Filter Symmetric Difference": {
      "main": [
        [
          { "node": "Clean Output", "type": "main", "index": 0 }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  }
}